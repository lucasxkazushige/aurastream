{
  "name": "aurastream-desktop",
  "version": "1.0.1",
  "description": "AuraStream 4K Desktop Player com aceleracao de hardware para TV e PC",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "release:win": "electron-builder --win --publish always",
    "release:linux": "electron-builder --linux --publish always"
  },
  "keywords": [
    "streaming",
    "4k",
    "webtorrent",
    "hls",
    "aurastream"
  ],
  "author": {
    "name": "AuraStream",
    "email": "contato@aurastream.com"
  },
  "homepage": "https://github.com/lucasxkazushige/aurastream",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aurastream.desktop",
    "productName": "AuraStream 4K",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lucasxkazushige",
        "repo": "aurastream",
        "releaseType": "release"
      }
    ],
    "win": {
      "extraResources": [
        {
          "from": "native-player/publish",
          "to": "AuraPlayer",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AuraStream 4K",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
